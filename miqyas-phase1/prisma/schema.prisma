// ═══════════════════════════════════════════════════════════════
//  منصة مِقياس — نموذج البيانات
//  جمعية الزاد · Next.js + PostgreSQL
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── المستخدمون والصلاحيات ────────────────────────────────────────
enum Role {
  SYSTEM_ADMIN     // مشرف النظام (مكتب الأداء / إدارة المشاريع)
  EXECUTIVE        // الإدارة العليا
  DEPT_MANAGER     // مدير إدارة
  SECTION_HEAD     // رئيس قسم
  EMPLOYEE         // موظف
  INTERNAL_AUDITOR // مراجع داخلي (م2)
  AUDIT_COMMITTEE  // عضو لجنة المراجعة (م3)
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(EMPLOYEE)
  status       UserStatus @default(ACTIVE)
  departmentId Int?
  sectionId    Int?
  lastLogin    DateTime?
  createdAt    DateTime   @default(now())

  department      Department?        @relation(fields: [departmentId], references: [id])
  section         Section?           @relation(fields: [sectionId], references: [id])
  ownedKpis       Kpi[]              @relation("KpiOwner")
  ownedRequirements MeasurementRequirement[] @relation("RequirementOwner")
  entries         KpiEntry[]         @relation("EnteredBy")
  approvals       KpiEntry[]         @relation("ApprovedBy")
  measurementEntries MeasurementPeriod[] @relation("MeasurementEnteredBy")
  measurementApprovals MeasurementPeriod[] @relation("MeasurementApprovedBy")
  measurementInitialApprovals MeasurementPeriod[] @relation("MeasurementInitialApprovedBy")
  evidenceRejections Evidence[] @relation("EvidenceRejectedBy")
  approvalEvents  ApprovalEvent[]
  evidences       Evidence[]
  notifications   Notification[]
  actions         CorrectiveAction[] @relation("ActionResponsible")
  deviationCards  DeviationCard[]    @relation("CardCreator")
  auditLogs       AuditLog[]
  loginAttempts   LoginAttempt[]
  calendarEventsCreated CalendarEvent[] @relation("CalendarCreatedBy")
  calendarEventsUpdated CalendarEvent[] @relation("CalendarUpdatedBy")
  auditYearPlansCreated AuditYearPlan[] @relation("AuditPlanCreatedBy")
  auditEngagementsCreated AuditEngagement[] @relation("AuditEngagementCreatedBy")
  auditFindingsCreated AuditFinding[] @relation("AuditFindingCreatedBy")
  auditCorrectiveActions AuditCorrectiveAction[] @relation("AuditActionResponsible")
  auditWorkingPapersUploaded AuditWorkingPaper[] @relation("AuditPaperUploadedBy")
  auditReportsCreated AuditReport[] @relation("AuditReportCreatedBy")
  committeeMeetingsCreated CommitteeMeeting[] @relation("CommitteeMeetingCreatedBy")
  committeeMinutesCreated CommitteeMinute[] @relation("CommitteeMinuteCreatedBy")
  committeeDecisionsCreated CommitteeDecision[] @relation("CommitteeDecisionCreatedBy")
  externalAuditUploads ExternalAuditUpload[] @relation("ExternalAuditUploadedBy")
}

// ── الهيكل التنظيمي ─────────────────────────────────────────────
model Department {
  id       Int    @id @default(autoincrement())
  deptNo   Int    @unique
  name     String
  color    String @default("#8b1a2a")

  sections         Section[]
  users            User[]
  operationalGoals OperationalGoal[]
  kpis             Kpi[]
  knowledgeAssets  KnowledgeAsset[]
  requirements     MeasurementRequirement[]
  calendarEvents   CalendarEvent[]
  auditEngagements AuditEngagement[]
  auditFindings    AuditFinding[]
}

model Section {
  id           Int    @id @default(autoincrement())
  sectionNo    Int
  name         String
  code         String @unique // مثال: "1/1"
  departmentId Int

  department       Department        @relation(fields: [departmentId], references: [id])
  users            User[]
  operationalGoals OperationalGoal[]
  kpis             Kpi[]
  requirements     MeasurementRequirement[]
  calendarEvents   CalendarEvent[]
  auditEngagements AuditEngagement[]

  @@unique([departmentId, sectionNo])
}

// ── الأهداف ─────────────────────────────────────────────────────
model StrategicGoal {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  title       String
  description String?
  sortOrder   Int     @default(0)

  kpis             Kpi[]
  operationalGoals OperationalGoal[]
}

model OperationalGoal {
  id              Int    @id @default(autoincrement())
  code            String @unique
  title           String
  departmentId    Int
  sectionId       Int?
  strategicGoalId Int? // الربط بالمسار الاستراتيجي عند وجوده

  department    Department     @relation(fields: [departmentId], references: [id])
  section       Section?       @relation(fields: [sectionId], references: [id])
  strategicGoal StrategicGoal? @relation(fields: [strategicGoalId], references: [id])
  kpis          Kpi[]
}

// ── المؤشرات ────────────────────────────────────────────────────
enum KpiType {
  STRATEGIC
  OPERATIONAL
}

/** مجال القياس الموحّد — استراتيجي / تشغيلي / حوكمة (شاهد واحد) */
enum MeasurementDomain {
  STRATEGIC
  OPERATIONAL
  GOVERNANCE
}

enum Frequency {
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum Polarity {
  HIGHER_BETTER // زيادة القيمة أفضل
  LOWER_BETTER  // نقص القيمة أفضل (مثل معدل الدوران)
}

model Kpi {
  id                Int       @id @default(autoincrement())
  code              String    @unique
  name              String
  type              KpiType
  unit              String    @default("%")
  baseline          Float? // خط الأساس المعتمد
  annualTarget      Float? // المستهدف السنوي
  frequency         Frequency @default(QUARTERLY)
  polarity          Polarity  @default(HIGHER_BETTER)
  measureFormula    String? // آلية الاحتساب
  requiredData      String? // البيانات المطلوبة للقياس
  departmentId      Int?
  sectionId         Int?
  ownerId           Int? // الموظف المسؤول عن الإدخال
  ownerLabel        String? // نص الإدارة المالكة الخام عند عدم الربط
  recommendation    String? // توصيات قسم الاستراتيجية (تعريف المؤشر)
  strategicGoalId   Int?
  operationalGoalId Int?
  requirementId     Int? // متطلب القياس الموحّد (مصدر الشواهد/الفعلي)
  domain            MeasurementDomain @default(STRATEGIC)
  /** يغذي المسار الاستراتيجي — مستقل عن وسم الحوكمة */
  feedsStrategic    Boolean   @default(true)
  /** متطلب حوكمة — يمكن أن يجتمع مع feedsStrategic */
  isGovernanceRequirement Boolean @default(false)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())

  department      Department?             @relation(fields: [departmentId], references: [id])
  section         Section?                @relation(fields: [sectionId], references: [id])
  owner           User?                   @relation("KpiOwner", fields: [ownerId], references: [id])
  strategicGoal   StrategicGoal?          @relation(fields: [strategicGoalId], references: [id])
  operationalGoal OperationalGoal?        @relation(fields: [operationalGoalId], references: [id])
  requirement     MeasurementRequirement? @relation(fields: [requirementId], references: [id])
  targets         KpiTarget[]
  entries         KpiEntry[]
  alerts          EarlyWarningAlert[]
  deviationCards  DeviationCard[]
  knowledgeAssets KnowledgeAsset[]

  @@index([requirementId])
  @@index([departmentId])
  @@index([ownerId])
  @@index([active, type])
  @@index([domain])
  @@index([feedsStrategic])
  @@index([isGovernanceRequirement])
}

// دور من يملأ متطلب القياس (الطبقة 1)
enum FillerRole {
  EMPLOYEE
  SECTION_HEAD
  DEPT_MANAGER
}

// ── متطلب القياس الموحّد (مصدر واحد للاستراتيجي والتشغيلي) ─────
model MeasurementRequirement {
  id           Int               @id @default(autoincrement())
  code         String            @unique
  name         String
  unit         String            @default("%")
  polarity     Polarity          @default(HIGHER_BETTER)
  frequency    Frequency         @default(QUARTERLY)
  requiredData String?
  departmentId Int?
  sectionId    Int?
  ownerId      Int?
  fillerRole   FillerRole        @default(EMPLOYEE)
  domain       MeasurementDomain @default(STRATEGIC)
  feedsStrategic              Boolean @default(true)
  isGovernanceRequirement     Boolean @default(false)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  department              Department?              @relation(fields: [departmentId], references: [id])
  section                 Section?                 @relation(fields: [sectionId], references: [id])
  owner                   User?                    @relation("RequirementOwner", fields: [ownerId], references: [id])
  periods                 MeasurementPeriod[]
  kpis                    Kpi[]
  governanceRequirements  GovernanceRequirement[]

  @@index([ownerId])
  @@index([departmentId])
  @@index([sectionId])
  @@index([fillerRole])
  @@index([domain])
  @@index([feedsStrategic])
  @@index([isGovernanceRequirement])
}

model MeasurementPeriod {
  id                  Int            @id @default(autoincrement())
  requirementId       Int
  year                Int
  period              Period
  actualValue         Float
  whatHappened        String?
  howHappened         String?
  note                String?
  enteredById         Int
  approvalStatus      ApprovalStatus @default(DRAFT)
  approvedById        Int?
  approvedAt          DateTime?
  initialApprovedById Int?
  initialApprovedAt   DateTime?
  rejectReason        String?
  suggestedWording    String? // صياغة مقترحة عند رفض الصياغة
  reviewFeedback      Json? // ملاحظات مراجعة منظمة (حقول/شواهد)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  requirement       MeasurementRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  enteredBy         User                   @relation("MeasurementEnteredBy", fields: [enteredById], references: [id])
  approvedBy        User?                  @relation("MeasurementApprovedBy", fields: [approvedById], references: [id])
  initialApprovedBy User?                  @relation("MeasurementInitialApprovedBy", fields: [initialApprovedById], references: [id])
  evidences         Evidence[]
  approvalEvents    ApprovalEvent[]

  @@unique([requirementId, year, period])
  @@index([approvalStatus])
  @@index([year, period, approvalStatus])
}

// الفترة: Q1..Q4 / H1,H2 / Y
enum Period {
  Q1
  Q2
  Q3
  Q4
  H1
  H2
  Y
}

model KpiTarget {
  id          Int    @id @default(autoincrement())
  kpiId       Int
  year        Int
  period      Period
  targetValue Float

  kpi Kpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([kpiId, year, period])
}

// ── حالات اعتماد القياس (ثلاث طبقات) ───────────────────────────
enum ApprovalStatus {
  DRAFT // مسودة — لم يُقدَّم
  SUBMITTED // مقدَّم — بانتظار مدير الإدارة
  INITIAL_APPROVED // معتمد مبدئياً — بانتظار مشرف النظام
  FINAL_APPROVED // معتمد نهائياً
  REJECTED_WORDING // مرفوض صياغة
  REJECTED_EVIDENCE // مرفوض شواهد
  // قيم قديمة للتوافق أثناء الترحيل
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalEventAction {
  SAVE_DRAFT
  SUBMIT
  INITIAL_APPROVE
  FINAL_APPROVE
  REJECT_WORDING
  REJECT_EVIDENCE
  RETURN_EDIT
  ADMIN_EDIT
}

model ApprovalEvent {
  id                  Int                 @id @default(autoincrement())
  measurementPeriodId Int
  actorId             Int
  action              ApprovalEventAction
  comment             String?
  payload             String? // JSON اختياري (صياغة مقترحة / شواهد مرفوضة)
  createdAt           DateTime            @default(now())

  measurementPeriod MeasurementPeriod @relation(fields: [measurementPeriodId], references: [id], onDelete: Cascade)
  actor             User              @relation(fields: [actorId], references: [id])

  @@index([measurementPeriodId])
}

enum KpiStatus {
  ACHIEVED // ≥ 100%
  ON_TRACK // ≥ 80%
  AT_RISK  // ≥ 60%
  CRITICAL // < 60%
  NO_DATA
}

model KpiEntry {
  id             Int            @id @default(autoincrement())
  kpiId          Int
  year           Int
  period         Period
  actualValue    Float
  achievementPct Float? // نسبة التحقق المحسوبة
  deviationValue Float? // قيمة الانحراف (محسوبة)
  whatHappened   String? // ماذا حصل؟ (الموظف)
  howHappened    String? // كيف حصل؟ (الموظف)
  recommendation String? // توصيات القسم (المشرف فقط)
  status         KpiStatus      @default(NO_DATA)
  note           String?
  enteredById    Int
  approvalStatus ApprovalStatus @default(DRAFT)
  approvedById   Int?
  approvedAt     DateTime?
  rejectReason   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  kpi        Kpi         @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  enteredBy  User        @relation("EnteredBy", fields: [enteredById], references: [id])
  approvedBy User?       @relation("ApprovedBy", fields: [approvedById], references: [id])
  evidences  Evidence[] // توافق مؤقت — المصدر المفضّل MeasurementPeriod.evidences

  @@unique([kpiId, year, period])
  @@index([year, period, approvalStatus])
}

enum EvidenceStatus {
  ACTIVE
  REJECTED
}

// الشواهد المرفوعة — تُفضَّل على MeasurementPeriod (مصدر موحّد)
model Evidence {
  id                  Int            @id @default(autoincrement())
  kpiEntryId          Int? // توافق قديم
  measurementPeriodId Int? // المصدر الموحّد
  fileName            String
  storedName          String
  mimeType            String
  sizeBytes           Int
  uploadedById        Int
  status              EvidenceStatus @default(ACTIVE)
  rejectReason        String?
  rejectedById        Int?
  rejectedAt          DateTime?
  createdAt           DateTime       @default(now())

  entry             KpiEntry?          @relation(fields: [kpiEntryId], references: [id], onDelete: Cascade)
  measurementPeriod MeasurementPeriod? @relation(fields: [measurementPeriodId], references: [id], onDelete: Cascade)
  uploadedBy        User               @relation(fields: [uploadedById], references: [id])
  rejectedBy        User?              @relation("EvidenceRejectedBy", fields: [rejectedById], references: [id])

  @@index([measurementPeriodId])
  @@index([kpiEntryId])
}

// ── الإنذار المبكر ──────────────────────────────────────────────
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model EarlyWarningAlert {
  id             Int       @id @default(autoincrement())
  kpiId          Int
  year           Int
  period         Period
  expectedToDate Float // المستهدف المتوقع حتى تاريخ القراءة
  actualToDate   Float // المتحقق الفعلي
  gapPct         Float
  riskLevel      RiskLevel
  message        String
  recipients     String // بريد المستلمين (مدير الإدارة، رئيس القسم)
  emailSent      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  kpi Kpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([year, period])
}

// ── بطاقات انحراف المؤشرات ──────────────────────────────────────
enum CardStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model DeviationCard {
  id           Int        @id @default(autoincrement())
  kpiId        Int
  year         Int
  period       Period
  targetValue  Float
  actualValue  Float
  deviationPct Float
  reasons      String // أسباب الانحراف
  status       CardStatus @default(OPEN)
  createdById  Int
  createdAt    DateTime   @default(now())
  closedAt     DateTime?

  kpi       Kpi                @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  createdBy User               @relation("CardCreator", fields: [createdById], references: [id])
  actions   CorrectiveAction[]

  @@unique([kpiId, year, period])
}

enum ActionStatus {
  PENDING
  IN_PROGRESS
  DONE
  LATE
}

model CorrectiveAction {
  id              Int          @id @default(autoincrement())
  deviationCardId Int
  description     String
  responsibleId   Int? // المسؤول عن التنفيذ
  responsibleName String? // أو اسم حر للجهة
  dueDate         DateTime // الإطار الزمني للمعالجة
  status          ActionStatus @default(PENDING)
  completedAt     DateTime?
  escalatedAt     DateTime? // تاريخ التصعيد للمشرف
  createdAt       DateTime     @default(now())

  card        DeviationCard @relation(fields: [deviationCardId], references: [id], onDelete: Cascade)
  responsible User?         @relation("ActionResponsible", fields: [responsibleId], references: [id])
}

// ── الحوكمة ─────────────────────────────────────────────────────
enum GovernanceStatus {
  COMPLIANT
  PARTIAL
  NON_COMPLIANT
  PENDING
}

model GovernanceRequirement {
  id                      Int              @id @default(autoincrement())
  code                    String           @unique
  title                   String
  category                String?
  year                    Int
  owner                   String?
  status                  GovernanceStatus @default(PENDING)
  compliancePct           Float            @default(0)
  notes                   String?
  measurementRequirementId Int? // ربط اختياري بشاهد القياس الموحّد — دون حذف السجل
  updatedAt               DateTime         @updatedAt

  measurementRequirement MeasurementRequirement? @relation(fields: [measurementRequirementId], references: [id], onDelete: SetNull)

  @@index([measurementRequirementId])
}

// ── رزنامة مكتب الاستراتيجية / القسم ─────────────────────────────
model CalendarEvent {
  id           Int       @id @default(autoincrement())
  title        String
  startsAt     DateTime
  endsAt       DateTime?
  eventType    String    @default("GENERAL") // GENERAL | MEETING | DEADLINE | MILESTONE
  notes        String?
  departmentId Int?
  sectionId    Int?
  createdById  Int
  updatedById  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  section    Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("CalendarCreatedBy", fields: [createdById], references: [id])
  updatedBy  User?       @relation("CalendarUpdatedBy", fields: [updatedById], references: [id])

  @@index([startsAt])
  @@index([departmentId])
  @@index([sectionId])
}

enum ObservationStatus {
  OPEN
  CLOSED
}

model GovernanceObservation {
  id            Int               @id @default(autoincrement())
  title         String
  status        ObservationStatus @default(OPEN)
  openedYear    Int
  openedPeriod  Period
  closedYear    Int?
  closedPeriod  Period?
  createdAt     DateTime          @default(now())
  closedAt      DateTime?
}

// ── المعرفة المؤسسية ────────────────────────────────────────────
enum AssetStatus {
  ACTIVE
  DRAFT
  UNDER_REVIEW
  ARCHIVED
}

model KnowledgeAsset {
  id           Int         @id @default(autoincrement())
  title        String
  assetType    String? // دليل، سياسة، درس مستفاد...
  departmentId Int?
  kpiId        Int?
  status       AssetStatus @default(DRAFT)
  isUsed       Boolean     @default(false)
  year         Int
  period       Period
  createdAt    DateTime    @default(now())

  department Department? @relation(fields: [departmentId], references: [id])
  kpi        Kpi?        @relation(fields: [kpiId], references: [id], onDelete: SetNull)
}

// ── الإشعارات ───────────────────────────────────────────────────
enum NotificationType {
  EARLY_WARNING
  DEVIATION
  APPROVAL_REQUEST
  APPROVAL_RESULT
  ACTION_LATE
  SYSTEM
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model EmailLog {
  id        Int      @id @default(autoincrement())
  toEmail   String
  subject   String
  status    String // SENT / FAILED
  error     String?
  createdAt DateTime @default(now())
}

// ── إعدادات النظام وسجل التدقيق ─────────────────────────────────
model SystemSetting {
  key   String @id
  value String
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String // LOGIN / CREATE_KPI / APPROVE_ENTRY ...
  entity    String?
  entityId  Int?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  ip        String?
  success   Boolean
  userId    Int?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([email, createdAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// ── المراجعة الداخلية (م2) ───────────────────────────────────────
enum AuditPlanStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AuditEngagementStatus {
  PLANNED
  IN_PROGRESS
  REPORTING
  CLOSED
}

enum AuditFindingStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum AuditFindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditReportStatus {
  DRAFT
  ISSUED
}

enum AuditDocVisibility {
  INTERNAL_ONLY
  TEAM_AND_ADMIN
}

model AuditYearPlan {
  id          Int             @id @default(autoincrement())
  year        Int             @unique
  title       String
  status      AuditPlanStatus @default(DRAFT)
  notes       String?
  createdById Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy   User              @relation("AuditPlanCreatedBy", fields: [createdById], references: [id])
  engagements AuditEngagement[]
}

model AuditEngagement {
  id           Int                    @id @default(autoincrement())
  planId       Int
  title        String
  objective    String?
  departmentId Int?
  sectionId    Int?
  status       AuditEngagementStatus  @default(PLANNED)
  startsAt     DateTime?
  endsAt       DateTime?
  createdById  Int
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  plan          AuditYearPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  department    Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  section       Section?            @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdBy     User                @relation("AuditEngagementCreatedBy", fields: [createdById], references: [id])
  findings      AuditFinding[]
  workingPapers AuditWorkingPaper[]
  reports       AuditReport[]

  @@index([planId])
  @@index([departmentId])
  @@index([status])
}

model AuditFinding {
  id           Int                  @id @default(autoincrement())
  engagementId Int
  title        String
  description  String?
  severity     AuditFindingSeverity @default(MEDIUM)
  status       AuditFindingStatus   @default(OPEN)
  departmentId Int?
  riskNote     String?
  createdById  Int
  closedAt     DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  engagement AuditEngagement         @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  department Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  User                    @relation("AuditFindingCreatedBy", fields: [createdById], references: [id])
  actions    AuditCorrectiveAction[]

  @@index([engagementId])
  @@index([status])
  @@index([severity])
}

model AuditCorrectiveAction {
  id              Int          @id @default(autoincrement())
  findingId       Int
  description     String
  responsibleId   Int?
  responsibleName String?
  dueDate         DateTime
  status          ActionStatus @default(PENDING)
  completedAt     DateTime?
  createdAt       DateTime     @default(now())

  finding     AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  responsible User?        @relation("AuditActionResponsible", fields: [responsibleId], references: [id])

  @@index([findingId])
  @@index([status])
}

model AuditWorkingPaper {
  id           Int                @id @default(autoincrement())
  engagementId Int
  title        String
  fileName     String
  storedName   String
  mimeType     String
  sizeBytes    Int
  visibility   AuditDocVisibility @default(INTERNAL_ONLY)
  uploadedById Int
  createdAt    DateTime           @default(now())

  engagement AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  uploadedBy User            @relation("AuditPaperUploadedBy", fields: [uploadedById], references: [id])

  @@index([engagementId])
}

model AuditReport {
  id           Int               @id @default(autoincrement())
  engagementId Int
  title        String
  summary      String?
  status       AuditReportStatus @default(DRAFT)
  fileName     String?
  storedName   String?
  mimeType     String?
  sizeBytes    Int?
  issuedAt     DateTime?
  createdById  Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  engagement AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  createdBy  User            @relation("AuditReportCreatedBy", fields: [createdById], references: [id])
  externalUploads ExternalAuditUpload[]

  @@index([engagementId])
  @@index([status])
}

// ── لجنة المراجعة (م3) ──────────────────────────────────────────
enum CommitteeMeetingStatus {
  SCHEDULED
  HELD
  CANCELLED
}

enum CommitteeDecisionStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum ExternalUploadStatus {
  PENDING_REVIEW
  ACKNOWLEDGED
}

model CommitteeMeeting {
  id          Int                     @id @default(autoincrement())
  title       String
  scheduledAt DateTime
  location    String?
  agenda      String?
  status      CommitteeMeetingStatus  @default(SCHEDULED)
  createdById Int
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  createdBy User                   @relation("CommitteeMeetingCreatedBy", fields: [createdById], references: [id])
  minutes   CommitteeMinute[]
  decisions CommitteeDecision[]
  uploads   ExternalAuditUpload[]

  @@index([scheduledAt])
  @@index([status])
}

model CommitteeMinute {
  id          Int      @id @default(autoincrement())
  meetingId   Int
  body        String
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meeting   CommitteeMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy User             @relation("CommitteeMinuteCreatedBy", fields: [createdById], references: [id])

  @@index([meetingId])
}

model CommitteeDecision {
  id             Int                     @id @default(autoincrement())
  meetingId      Int?
  title          String
  recommendation String?
  ownerName      String?
  dueDate        DateTime?
  status         CommitteeDecisionStatus @default(OPEN)
  createdById    Int
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  meeting   CommitteeMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdBy User              @relation("CommitteeDecisionCreatedBy", fields: [createdById], references: [id])

  @@index([meetingId])
  @@index([status])
}

model ExternalAuditUpload {
  id           Int                  @id @default(autoincrement())
  title        String
  notes        String?
  fileName     String
  storedName   String
  mimeType     String
  sizeBytes    Int
  status       ExternalUploadStatus @default(PENDING_REVIEW)
  meetingId    Int?
  reportId     Int?
  uploadedById Int
  createdAt    DateTime             @default(now())

  meeting    CommitteeMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  report     AuditReport?      @relation(fields: [reportId], references: [id], onDelete: SetNull)
  uploadedBy User              @relation("ExternalAuditUploadedBy", fields: [uploadedById], references: [id])

  @@index([meetingId])
  @@index([reportId])
  @@index([status])
}
